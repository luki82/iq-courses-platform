# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the service dashboard instead.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=True

# Comma-separated list of allowed hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite automatically. On Render, this is provided
# by the attached Postgres database, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

TIME_ZONE=UTC

# How many full-detail free IQ test attempts a non-premium user gets.
FREE_TEST_ATTEMPTS_LIMIT=1

# Stripe (from https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SITE_URL=http://127.0.0.1:8000
